# Copy this file to .env and fill in real values. Never commit .env.
# Used only by the Node server (server/index.js); it is never sent to the browser.
OPENAI_API_KEY=your-openai-api-key
# Optional: model to use (defaults to gpt-5.5)
OPENAI_MODEL=
# Optional: port for the API server (defaults to 3001)
PORT=
