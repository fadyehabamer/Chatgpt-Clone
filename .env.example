# Copy this file to .env and fill in real values. Never commit .env.
# Used only server-side (server/index.js locally, api/chat.js on Vercel); never sent to the browser.
# On Vercel, set these in the project's Environment Variables instead.
OPENAI_API_KEY=your-openai-api-key
# Optional: model to use (defaults to gpt-5.5)
OPENAI_MODEL=
# Optional: port for the API server (defaults to 3001)
PORT=
